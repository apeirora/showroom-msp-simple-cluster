# Raw dumps from remote clusters — may contain bearer tokens / Secrets.
imports/

kubeconfig.yaml
kubeconfig-*.yaml

# IDE / sandbox state
.idea/
.chroot/

# kubebuilder helm/v1-alpha intermediate output — the consolidated
# charts live under charts/ and are regenerated by
# scripts/regen-helm-charts.sh.
**/dist/chart/

# Local scratch state — never publish.
.notes/
DESIGN.md

# Credentials and local environment files.
*.env
.env
*openrc*
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*

# hack/crdcheck is run with go run; never commit its binary
hack/crdcheck/crdcheck
