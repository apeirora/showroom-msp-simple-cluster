{
  "providers": [
    "cloudferro",
    "gardener-sap-ironcore",
    "gardener-sap-openstack",
    "kind"
  ],
  "providerSources": [
    {
      "group": "dati.eu",
      "version": "v1alpha1",
      "listField": "Shoots",
      "label": "Dati (Gardener Shoot)",
      "providerConfigName": "dati"
    },
    {
      "group": "sap.eu",
      "version": "v1alpha1",
      "listField": "OpenStackShoots",
      "label": "SAP Gardener (OpenStack)",
      "providerConfigName": "sap-gardener-openstack"
    },
    {
      "group": "sap.eu",
      "version": "v1alpha1",
      "listField": "IronCoreShoots",
      "label": "SAP Gardener (IronCore)",
      "providerConfigName": "sap-gardener-ironcore"
    },
    {
      "group": "apeiro.eu",
      "version": "v1alpha1",
      "listField": "OpenStackShoots",
      "label": "Apeiro Gardener (OpenStack)",
      "providerConfigName": "apeiro-gardener-openstack"
    },
    {
      "group": "apeiro.eu",
      "version": "v1alpha1",
      "listField": "IronCoreShoots",
      "label": "Apeiro Gardener (IronCore)",
      "providerConfigName": "apeiro-gardener-ironcore"
    },
    {
      "group": "cloudferro.eu",
      "version": "v1alpha1",
      "listField": "OpenStackVMs",
      "label": "CloudFerro",
      "providerConfigName": "cloudferro",
      "namespaced": true
    },
    {
      "group": "arsys.eu",
      "version": "v1alpha1",
      "listField": "UbuntuMachines",
      "label": "Arsys (virtual)",
      "providerConfigName": "arsys-virtual",
      "namespaced": true
    }
  ],
  "encryptionProviders": {
    "cloudferro": [
      "OpenBao"
    ]
  },
  "encryptionKeyStores": {
    "OpenBao": {
      "address": "https://openbao.cc-d2.showroom.apeirora.eu",
      "namespace": "simple-cluster",
      "keys": "One Transit key per cluster, created with the cluster and removed with it."
    }
  },
  "cpu": [
    "1",
    "2",
    "4",
    "8",
    "16"
  ],
  "memory": [
    "2Gi",
    "4Gi",
    "8Gi",
    "16Gi",
    "32Gi"
  ],
  "controlPlane": {
    "min": 1,
    "max": 10,
    "default": 1
  },
  "workers": {
    "min": 1,
    "max": 10,
    "default": 1
  }
}
